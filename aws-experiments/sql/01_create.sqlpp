-- Dataset creation for the NLJ static-memory experiment.
-- Compression disabled explicitly per dataset so on-disk size is honest.
-- Safe to re-run: drops the whole dataverse first.

DROP DATAVERSE tpcds IF EXISTS;
CREATE DATAVERSE tpcds;
USE tpcds;

-- One minimal open type: every field beyond the key stays open.
CREATE TYPE TpcdsRow AS { uuid: uuid };

CREATE DATASET customer(TpcdsRow) PRIMARY KEY uuid AUTOGENERATED
  WITH {"storage-block-compression": {"scheme": "none"}};

CREATE DATASET store_returns(TpcdsRow) PRIMARY KEY uuid AUTOGENERATED
  WITH {"storage-block-compression": {"scheme": "none"}};
